{
  "name": "nestjs-project-template",
  "version": "1.1.0",
  "description": "NestJS project structure template with best practices using Fastify, Drizzle, PostgreSQL, and Bun",
  "type": "module",
  "main": "dist/main.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build:nest": "nest build --builder swc",
    "format": "biome format --write .",
    "start": "bun run apps/api/src/main.ts",
    "start:dev": "bun --watch run apps/api/src/main.ts",
    "start:debug": "bun --inspect --watch run apps/api/src/main.ts",
    "start:prod": "bun dist/main.js",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "ci": "bun scripts/ci.ts",
    "ci:quick": "bun scripts/ci.ts quick",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:push": "drizzle-kit push",
    "drizzle:studio": "drizzle-kit studio",
    "db:seed": "bun apps/api/src/database/seed.ts",
    "db:reset": "bun run drizzle:push -- --force && bun run db:seed",
    "db:setup": "bun run drizzle:push && bun run db:seed",
    "openapi:export": "bun apps/api/src/openapi-codegen.ts"
  },
  "keywords": [],
  "author": {
    "name": "fuyou",
    "email": "imshuazi@126.com",
    "url": "https://github.com/lifefloating"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/lib-storage": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@fastify/compress": "^9.2.1",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.6",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/cqrs": "^12.1.0",
    "@nestjs/platform-fastify": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "ali-oss": "^6.23.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.12.5",
    "joi": "^18.2.9",
    "js-yaml": "^5.4.3",
    "mjml": "^5.4.1",
    "nestjs-i18n": "^10",
    "nodemailer": "^10.1.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "stripe": "^23.0.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@types/ali-oss": "^6.23.3",
    "@types/bun": "^1.4.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^5.0.4",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.5",
    "vitest": "^5.0.4"
  }
}
